# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini（原本用 OpenAI，因為沒有免費額度改用 Gemini）
# 到 https://aistudio.google.com/apikey 建立 API key
GEMINI_API_KEY=

# Rate Limit（Upstash Redis，Step 25：取代原本的記憶體內計數）
# 到 https://console.upstash.com 建立一個 Redis database 後，在 REST API 分頁可以看到這兩個值。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
